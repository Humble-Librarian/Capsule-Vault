{
  "manifest_version": 3,
  "name": "Context Vault",
  "version": "2.0.0",
  "description": "Auto-save and retrieve browsing context locally.",

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus"
  ],

  "host_permissions": [
    "https://api.groq.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Vault",
    "default_icon": "icons/icon48.png"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save selected text to Context Vault"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      }
    }
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle"
  }]
}
